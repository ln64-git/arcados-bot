{
	"name": "arcados-bot",
	"version": "1.0.0",
	"description": "A minimal Discord bot template with dynamic command support",
	"main": "src/main.ts",
	"type": "module",
	"scripts": {
		"start": "npx tsx src/main.ts",
		"start:dev": "npx tsx src/main.ts",
		"dev": "npx tsx --watch src/main.ts",
		"start:prod": "NODE_ENV=production node dist/main.js",
		"start:debug": "NODE_ENV=development npx tsx --inspect src/main.ts",
		"build": "tsc",
		"build:prod": "tsc && npm run clean:build",
		"clean": "rm -rf dist",
		"clean:build": "rm -rf dist && rm -rf node_modules/.cache",
		"format": "biome format --write .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"stats": "NODE_ENV=development npx tsx -e \"import { getCommandStats } from './src/utils/loadCommands.js'; console.log('Command Stats:', getCommandStats());\"",
		"sync:channel": "npx tsx src/scripts/sync-single-channel.ts",
		"regenerate:conversations": "npx tsx src/scripts/regenerate-conversations.ts",
		"regenerate:conversations:advanced": "npx tsx src/scripts/regenerate-conversations-advanced.ts",
		"generate:embeddings": "bun --bun src/scripts/generate-embeddings.ts",
		"regenerate:relationships": "npx tsx src/scripts/regenerate-relationships.ts",
		"view:relationships": "npx tsx src/scripts/test-relationships.ts",
		"view:recent": "npx tsx src/scripts/view-recent-activity.ts",
		"view:active-channels": "npx tsx src/scripts/list-active-channels.ts",
		"inspect:conversations": "npx tsx src/scripts/inspect-active-conversations.ts",
		"inspect:conversations:status": "npx tsx src/scripts/inspect-conversations-by-status.ts",
		"summary:conversations:24h": "npx tsx src/scripts/summary-conversations-24h.ts",
		"identify:bots": "npx tsx src/scripts/identify-bots.ts",
		"analyze:relationships": "npx tsx src/scripts/analyze-relationships.ts",
		"analyze:conversations": "npx tsx src/scripts/analyze-conversations.ts",
		"analyze:conversation-accuracy": "npx tsx src/scripts/analyze-conversation-accuracy.ts",
		"analyze:bot-mentions": "npx tsx src/scripts/analyze-bot-mentions.ts",
		"test:conversation-mapping": "npx tsx src/scripts/test-conversation-mapping.ts",
		"analyze:conversation": "npx tsx src/scripts/analyze-specific-conversation.ts",
		"analyze:segment": "npx tsx src/scripts/analyze-conversation-segment.ts",
		"list:messages": "npx tsx src/scripts/list-messages.ts",
		"test:enhanced-batch": "npx tsx src/scripts/test-enhanced-batch-mode.ts",
		"analyze:user": "npx tsx src/scripts/analyze-user.ts",
		"clean:segments": "npx tsx src/scripts/clean-segments-bot-commands.ts",
		"consolidate:segments": "npx tsx src/scripts/consolidate-segments.ts",
		"recreate:schema": "npx tsx src/scripts/recreate-postgres-schema.ts",
		"drop:all": "npx tsx src/scripts/drop-all-postgres-data.ts"
	},
	"keywords": [
		"discord",
		"bot",
		"template",
		"typescript"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^1.8.0",
		"@types/node": "^20.0.0",
		"concurrently": "^8.0.0",
		"nodemon": "^3.0.0",
		"tsx": "^4.20.3",
		"typescript": "^5.0.0"
	},
	"dependencies": {
		"@google/generative-ai": "^0.24.1",
		"@langchain/community": "^0.3.57",
		"@langchain/core": "^0.3.78",
		"@langchain/openai": "^0.6.16",
		"@types/pg": "^8.15.5",
		"@types/uuid": "^10.0.0",
		"@xenova/transformers": "^2.17.2",
		"axios": "^1.12.2",
		"chalk": "^5.6.2",
		"discord.js": "^14.16.3",
		"dotenv": "^16.4.5",
		"install": "^0.13.0",
		"langchain": "^0.3.36",
		"pg": "^8.16.3",
		"uuid": "^13.0.0"
	},
	"engines": {
		"node": ">=18.0.0",
		"npm": ">=8.0.0"
	},
	"biome": {
		"$schema": "https://biomejs.dev/schemas/1.8.0/schema.json",
		"vcs": {
			"enabled": true,
			"clientKind": "git",
			"useIgnoreFile": true
		},
		"files": {
			"ignoreUnknown": false,
			"ignore": [
				"node_modules",
				"dist",
				"*.min.js"
			]
		},
		"formatter": {
			"enabled": true,
			"indentStyle": "tab",
			"indentWidth": 2,
			"lineWidth": 100
		},
		"linter": {
			"enabled": true,
			"rules": {
				"recommended": true,
				"complexity": {
					"noExcessiveCognitiveComplexity": "warn"
				},
				"performance": {
					"noAccumulatingSpread": "warn"
				}
			}
		},
		"javascript": {
			"formatter": {
				"quoteStyle": "double",
				"semicolons": "always",
				"trailingCommas": "es5"
			}
		}
	}
}
